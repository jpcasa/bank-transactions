# --- docker compose (local) ---
POSTGRES_PASSWORD=postgres

# --- api ---
# Local compose DB (host port 55432):
DATABASE_URL=postgres://postgres:postgres@localhost:55432/transactions
# Hosted Supabase (Dashboard > Connect > Transaction pooler). Pooler (6543) does
# not support prepared statements; the postgres driver needs `prepare: false`.
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
PORT=8787
CORS_ORIGIN=http://localhost:5173
SEED=true

# --- web (build-time) ---
VITE_API_URL=http://localhost:8787
